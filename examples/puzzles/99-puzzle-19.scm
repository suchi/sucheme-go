; 99: RPN Expression Evaluator with Error Handling
; A robust Reverse Polish Notation evaluator that handles:
; - Multiple operators (+, -, *, /, mod, pow)
; - Stack underflow detection
; - Division by zero detection

(define (rpn-eval tokens)
  (define (binary-op op stack)
    (if (< (length stack) 2)
        (list 'error "Stack underflow")
        (let ((b (car stack))
              (a (car (cdr stack)))
              (rest (cdr (cdr stack))))
          (cond ((and (equal? op '/) (= b 0))
                 (list 'error "Division by zero"))
                ((and (equal? op 'mod) (= b 0))
                 (list 'error "Modulo by zero"))
                (else
                 (let ((result
                        (cond ((equal? op '+) (+ a b))
                              ((equal? op '-) (- a b))
                              ((equal? op '*) (* a b))
                              ((equal? op '/) (/ a b))
                              ((equal? op 'mod) (modulo a b))
                              ((equal? op 'pow)
                               (let loop ((n b) (acc 1))
                                 (if (= n 0) acc (loop (- n 1) (* acc a))))))))
                   (cons result rest)))))))
  (define (check-pow-arg op a b)
    (and (equal? op 'pow) (< b 0)))
  (define (binary-op-safe op stack)
    (if (and (>= (length stack) 2)
             (check-pow-arg op (car (cdr stack)) (car stack)))
        (list 'error "Negative exponent")
        (binary-op op stack))))
  (define (operator? t)
    (or (equal? t '+) (equal? t '-) (equal? t '*)
        (equal? t '/) (equal? t 'mod) (equal? t 'pow)))
  (let loop ((tokens tokens) (stack '()))
    (cond ((null? tokens)
           (if (= (length stack) 1)
               (list 'ok (car stack))
               (list 'error "Too many values on stack")))
          ((operator? (car tokens))
           (let ((result (binary-op-safe (car tokens) stack)))
             (if (equal? (car result) 'error)
                 result
                 (loop (cdr tokens) result))))
          ((number? (car tokens))
           (loop (cdr tokens) (cons (car tokens) stack)))
          (else (list 'error "Unknown token")))))

(define (test-rpn label tokens)
  (display "  ") (display label) (display " => ")
  (let ((result (rpn-eval tokens)))
    (if (equal? (car result) 'ok)
        (display (car (cdr result)))
        (begin (display "ERROR: ") (display (car (cdr result)))))
    (newline)))

(display "RPN Evaluator:") (newline)
(test-rpn "3 4 +" '(3 4 +))
(test-rpn "10 2 - 3 *" '(10 2 - 3 *))
(test-rpn "2 10 pow" '(2 10 pow))
(test-rpn "15 7 mod" '(15 7 mod))
(test-rpn "5 1 2 + 4 * + 3 -" '(5 1 2 + 4 * + 3 -))
(test-rpn "10 0 /" '(10 0 /))
(test-rpn "+" '(+))
(test-rpn "1 2 3 +" '(1 2 3 +))
(test-rpn "(empty)" '())
