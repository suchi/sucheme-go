; 90: Puzzle 10
; Sieve of Eratosthenes (with vectors)
(define (sieve n)
  (let ((v (make-vector (+ n 1) #t)))
    (vector-set! v 0 #f)
    (vector-set! v 1 #f)
    (let loop ((i 2))
      (when (<= (* i i) n)
        (when (vector-ref v i)
          (let inner ((j (* i i)))
            (when (<= j n)
              (vector-set! v j #f)
              (inner (+ j i)))))
        (loop (+ i 1))))
    (let collect ((i 2) (acc (list)))
      (if (> i n) (reverse acc)
          (if (vector-ref v i)
              (collect (+ i 1) (cons i acc))
              (collect (+ i 1) acc))))))
(display (sieve 50))
(newline)
