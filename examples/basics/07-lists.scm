; 07: Lists
(display (list 1 2 3))     ; => (1 2 3)
(newline)
(display (car '(a b c)))   ; => a
(newline)
(display (cdr '(a b c)))   ; => (b c)
(newline)
(display (cons 0 '(1 2)))  ; => (0 1 2)
(newline)
(display (length '(1 2 3 4 5)))  ; => 5
(newline)
(display (append '(1 2) '(3 4)))  ; => (1 2 3 4)
(newline)
(display (reverse '(1 2 3)))  ; => (3 2 1)
(newline)
