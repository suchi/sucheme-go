; 08: Strings
(display (string-length "hello"))  ; => 5
(newline)
(display (string-append "hello" " " "world"))  ; => hello world
(newline)
(display (substring "hello world" 6 11))  ; => world
(newline)
(display (string-upcase "hello"))  ; => HELLO
(newline)
(display (string->number "42"))  ; => 42
(newline)
(display (number->string 3.14))  ; => 3.14
(newline)
